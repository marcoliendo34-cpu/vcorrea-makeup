{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/cursos/:slug",
      "destination": "/curso"
    }
  ],
  "headers": [
    {
      "source": "/(admin|mi-cuenta|ingresar|registro|nueva-contrasena)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
